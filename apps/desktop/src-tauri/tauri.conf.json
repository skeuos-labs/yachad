{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yachad",
  "version": "0.1.0",
  "identifier": "org.skeuoslabs.yachad",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yachad Management",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "visible": true
      },
      {
        "label": "tray-popover",
        "title": "Yachad",
        "width": 340,
        "height": 440,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
